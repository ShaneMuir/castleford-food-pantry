{
  "name": "castleford-food-pantry",
  "version": "0.1.0",
  "private": true,
  "description": "Tooling and test layer for the Castleford Community Food Pantry WordPress block theme. These scripts are developer conveniences and are not required for the theme to run.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pbt": "vitest run --testNamePattern \"Property\"",
    "test:e2e": "playwright test",
    "lint": "svgo --help >/dev/null 2>&1 && tsc --noEmit",
    "assets:convert": "node tools/convert-images.mjs",
    "assets:poster": "node tools/extract-poster.mjs",
    "assets:svg": "node tools/optimize-svg.mjs",
    "assets:all": "npm run assets:convert && npm run assets:poster && npm run assets:svg"
  },
  "overrides": {
    "playwright-core": "1.48.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "1.48.2",
    "@types/node": "20.17.6",
    "axe-core": "4.10.2",
    "fast-check": "3.23.1",
    "jsdom": "24.1.3",
    "sharp": "0.33.5",
    "svgo": "3.3.2",
    "typescript": "5.6.3",
    "vitest": "1.6.0"
  }
}
